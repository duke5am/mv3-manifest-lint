{
  "manifest_version": 3,
  "name": "Reading List Notes",
  "version": "1.4.0",
  "minimum_chrome_version": "114",
  "description": "Save the current page to a local reading list and attach a short note to it.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Save to reading list",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://example.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://example.com/*",
        "https://docs.example.com/*"
      ],
      "js": [
        "content/collect.js"
      ],
      "css": [
        "content/collect.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/collect.css",
        "icons/icon48.png"
      ],
      "matches": [
        "https://example.com/*",
        "https://docs.example.com/*"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      }
    }
  }
}
